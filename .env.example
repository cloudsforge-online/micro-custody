# Every variable this service reads, and nothing else.
#
# Rule 9 of docs/ecosystem/03 §2: a repository declares the variables it needs and the deploy
# provides exactly those. `env_file: .env` fan-out — which today hands eight containers all 64 of
# the estate's variables, including the master secret to a game server — is banned, and this file is
# what makes the alternative possible: the deploy manifest is derived from it.
#
# Copy to `.env` for local work. `.env` is gitignored and must stay that way.

# --- required --------------------------------------------------------------------------------

# This service's own database. It reads no other, and CI fails on a second connection string.
CUSTODY_DATABASE_URL=postgres://custody:custody@127.0.0.1:5432/custody

# Identity's JWKS and issuer. Token verification is the only thing custody asks identity for, and
# it is a read of a public document rather than a call made on a user's behalf.
IDENTITY_JWKS_URL=http://127.0.0.1:4001/.well-known/jwks.json
IDENTITY_ISSUER=http://127.0.0.1:4001

# THE ONLY SERVICE CUSTODY CALLS. 03 §3 and SD-13: no RPC providers, no price feeds, no product
# services. Its network reachability is the whole security model, so a second URL in this file would
# be the defect rather than the feature.
POLICY_BASE_URL=http://127.0.0.1:4009

# HMAC key for outbound event signatures. At least 32 random characters:
#   openssl rand -base64 32
# A placeholder here is refused at boot, deliberately. Do not paste one back in.
OUTBOX_SIGNING_SECRET=

# --- the master secret keyring -----------------------------------------------------------------
#
# THIS IS THE FIX FOR SDR-03, AND HOW A ROTATION IS PERFORMED.
#
# There is no single `CUSTODY_MASTER_SECRET`. Each envelope version has its own variable, and the
# version stamped on a stored blob selects which secret decrypts it. That is what makes the secret
# ROTATABLE: today's custody has one variable holding one secret, so changing it makes every
# custodied key undecryptable at once and a host compromise is unrecoverable.
#
# To rotate, in this order and no other:
#
#   1. Add CUSTODY_MASTER_SECRET_V3 (openssl rand -base64 48). LEAVE V2 IN PLACE.
#   2. Set CUSTODY_KEY_VERSION=3 and restart. New keys are written under it immediately; every
#      existing blob still decrypts under V2.
#   3. Watch `GET /v1/admin/rotation` — or the `custody_key_version_backlog` gauge — reach ZERO.
#      `pnpm reencrypt` forces the pass and exits non-zero while anything remains.
#   4. ONLY THEN remove CUSTODY_MASTER_SECRET_V2. Removing it at step 3 loses every key still on it.
#
# Adding a version needs no code change and no release. That is deliberate: a rotation that required
# one could not be performed during the incident that demands it.
CUSTODY_MASTER_SECRET_V2=

# Which version NEW blobs are written under. Defaults to the highest secret present, so it only has
# to be set to pin a rotation mid-flight or to roll one back before the pass has run.
# CUSTODY_KEY_VERSION=2

# --- optional, with the defaults shown ---------------------------------------------------------

# 4005, matching src/env.ts and the registry's `keyvault` entry. This said 4008, which
# micro-indexer also binds.
PORT=4005
NODE_ENV=development
LOG_LEVEL=info
CUSTODY_DATABASE_POOL_MAX=10

# Where the encrypted blobs live: one directory per address, 0700, each holding one `key.enc` at
# 0600. It must be a mounted volume that is backed up — and whose backups are stored SEPARATELY from
# the master secret, because a backup and its secret in one place is a plaintext key store with
# extra steps (SD-17).
CUSTODY_DATA_DIR=/var/lib/custody/keys

# The export ceremony's timers. SD-07 gates 4 and 7.
# The cooling-off is the only control in the ceremony that works while the user is actively being
# deceived on the phone. Shortening it for a staging rehearsal is supported; below one hour is
# refused at boot.
# CUSTODY_EXPORT_COOLING_OFF_HOURS=24
# CUSTODY_EXPORT_TOKEN_TTL_SECONDS=300
# CUSTODY_EXPORT_REQUEST_TTL_HOURS=168

# Rate limits, per CALLING CREDENTIAL rather than per address or per user — the thing being bounded
# is a leaked token, and an attacker holding one spreads across thousands of addresses.
# CUSTODY_SIGN_RATE_PER_MINUTE=60
# CUSTODY_ADDRESS_RATE_PER_HOUR=500

# Names this replica in jobs.locked_by. Defaults to the hostname.
# INSTANCE_ID=

# The image tag, reported on every log line and in the release manifest.
# CLOUDSFORGE_TAG=dev

# --- not read by this service ------------------------------------------------------------------
#
# OTEL_EXPORTER_OTLP_ENDPOINT and the rest of OTEL_* are read by the OpenTelemetry SDK loaded ahead
# of the process, not by src/env.ts. They belong in the deploy.
#
# CUSTODY_TEST_DATABASE_URL is read only by the test suite, and only when its name contains "test":
# the database-backed tests truncate, and that requirement is the difference between a red build and
# an emptied key store.
